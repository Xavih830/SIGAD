# SIGAD — Configuración de Cliente Flutter (Pública / No Confidencial)
# ADVERTENCIA: Este archivo es consumido por Flutter al compilar (--dart-define-from-file=.env.client).
# Las variables aquí definidas se empaquetan en el binario final (JS / APK).
# PROHIBIDO almacenar contraseñas, secretos JWT o credenciales de backend aquí.

API_BASE_URL=http://localhost:8000
