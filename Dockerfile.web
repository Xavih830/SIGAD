FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app

# Descarga de dependencias
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copia de código fuente y compilación release
COPY . .
ARG API_BASE_URL=http://localhost:8000
RUN flutter build web --release --no-wasm-dry-run --pwa-strategy=none --dart-define=API_BASE_URL=${API_BASE_URL}

FROM caddy:2-alpine

COPY --from=build /app/build/web /srv/flutter_web
COPY Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

