# ──────────────────────────────────────
#  SIGAD — Entorno Unificado Canónico (Ejemplo)
# ──────────────────────────────────────

# PostgreSQL
POSTGRES_USER=sigad
POSTGRES_PASSWORD=sigad_dev_2024
POSTGRES_DB=sigad_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+asyncpg://sigad:sigad_dev_2024@postgres:5432/sigad_db
DATABASE_SYNC_URL=postgresql://sigad:sigad_dev_2024@postgres:5432/sigad_db
SQL_ECHO=false

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Uvicorn
UVICORN_WORKERS=2
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# OTP HMAC & Claves Criptográficas (Generar con openssl rand -hex 32)
OTP_SECRET_KEY_ACTUAL=change-me-use-openssl-rand-hex-32-for-actual-quarter
OTP_SECRET_KEY_ANTERIOR=change-me-use-openssl-rand-hex-32-for-previous-quarter
OTP_EXPIRATION_MINUTES=15

# SMTP Backup Channel (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@rjseguros.ec
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Almacenamiento y Archivos
UPLOAD_DIR=uploads
MAX_DOCUMENT_SIZE_BYTES=15728640

# Base de Datos de Pruebas de Integración
TEST_DATABASE_URL=postgresql+asyncpg://sigad:sigad_dev_2024@localhost:5432/sigad_test_db
