<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de extracción de datos seguras para Android 12+ (API 31+) - CWE-538 / OWASP MASVS-STORAGE -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
